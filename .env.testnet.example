# Copy to .env.testnet (gitignored, never committed). TESTNET / DEMO keys only.
# Permissions: read + futures trade. NO withdrawal. IP whitelist recommended.

# Binance USD-M futures testnet: https://testnet.binancefuture.com
BINANCE_TESTNET_KEY=
BINANCE_TESTNET_SECRET=

# Bybit testnet: https://testnet.bybit.com
BYBIT_TESTNET_KEY=
BYBIT_TESTNET_SECRET=

# OKX demo trading (create the key while in Demo Trading mode)
OKX_DEMO_KEY=
OKX_DEMO_SECRET=
OKX_DEMO_PASSPHRASE=

# Optional: READ-ONLY mainnet keys (no trade, no withdrawal) to confirm the Gate / KuCoin / MEXC adapters
# with balance, positions, leverage and margin-mode reads. Leave empty to skip.
GATE_READONLY_KEY=
GATE_READONLY_SECRET=
KUCOIN_READONLY_KEY=
KUCOIN_READONLY_SECRET=
KUCOIN_READONLY_PASSPHRASE=
MEXC_READONLY_KEY=
MEXC_READONLY_SECRET=
